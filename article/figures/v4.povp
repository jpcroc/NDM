}

function _setModelState() {

  select ({17 18 34 35 48 67 68 87 88 107 108 127 128 145 146 160 174 188 203 218 247 262 263 278 279 294 295 310 311 326 327 340 341 359:361 387:390});
  Spacefill 0.4;
  select ({0:13 19:30 36:43 49:62 69:82 89:102 109:122 129:140 147:154 161:168 175:182 189:196 204:211 219:227 229:237 239:246 248:261 264:277 280:293 296:309 312:325 328:339 342:358 362:386});
  Spacefill 0.3;
  select ({14:16 31:33 44:47 63:66 83:86 103:106 123:126 141:144 155:159 169:173 183:187 197:202 212:217 228 238});
  Spacefill 0.2;
  select BONDS ({28:30 49 62:65 94:97 126:129 158:161 190:193 212 213 226:233 246:253 266:273 286:297 310:321});
  wireframe 0.08;
  select BONDS ({0:27 31:48 50:61 66:93 98:125 130:157 162:189 194:211 214:225 234:245 254:265 274:285 298:309 322:635});
  wireframe 0.1;

  measures delete;
  measure (({306})) (({304})); # distance 	2.8 	"0.28 nm" 	V/20.1 #11 	V/20.1 #9;
  measure (({306})) (({305})); # distance 	2.72 	"0.272 nm" 	V/20.1 #11 	V/20.1 #10;
  select *; set measures nanometers;
  font measures 15.0 SansSerif Plain;
  select measures ({0 1});
  measure "2:%VALUE %UNITS//nanometers";
  select measures ({null});

  hover "%U";
  select *;
  frame 1.1;
