function _setFrameState() {
# frame state;
# modelCount 24;
# first 1.1;
# last 24.1;
  frame RANGE 1.1 24.1;
  animation DIRECTION +1;
  animation FPS 10;
  animation MODE once 0.0 1.0;
  model 24.1;
  animation OFF;
}

function _setPerspectiveState() {
  set perspectiveModel 11;
  set scaleAngstromsPerInch 0.0;
  set perspectiveDepth false;
  set visualRange 5.0;
  set cameraDepth 3.0;
  boundbox corners {0.0 0.0 0.0} {5.7106 2.8553 2.8553} # volume = 46.557022;
  center {3.0 0.1385 5.8994};
   moveto -1.0 { 0 0 1000 81.28} 100.0 0.0 0.0 {2.8553 1.42765 1.42765} 5.2170143 {0 0 0} 0 0 0 3.0 0.0 0.0;
  save orientation "default";
  moveto 0.0 { -981 -124 -149 81.28} 100.0 0.0 0.0 {3.0 0.1385 5.8994} 5.2170143 {0 0 0} 0 0 0 3.0 0.0 0.0;;
  slab 100;depth 0;
  set slabRange 0.0;
  set spinX 0; set spinY 30; set spinZ 0; set spinFps 30;  set navX 0; set navY 0; set navZ 0; set navFps 10;
}

function _setSelectionState() {
  select ({17 18 34 35 48 67 68 87 88 107 108 127 128 145 146 160 174 188 203 218 247 262 263 278 279 294 295 310 311 326 327 340 341 359:361 387:390});
  set hideNotSelected false;
}

function _setState() {
  initialize;
  set refreshing false;
  _setWindowState;
  _setFileState;
  _setDefinedState;
  _setParameterState;
  _setModelState;
  _setFrameState;
  _setPerspectiveState;
  _setSelectionState;
  set refreshing true;
  set antialiasDisplay false;
  set antialiasTranslucent true;
  set antialiasImages true;
}

_setState;

