  \hline
  He$_1$V$_1$ & 1nn & 1.27 & & 1nn & 1.89 &\\
  He$_1$V$_2$ & 1nn $\rightarrow$ 2nn & 0.79 & & 1nn $\rightarrow$ 2nn & 1.14 &\\
  He$_1$V$_2$ & 2nn $\rightarrow$ 1nn & 0.88 & & 2nn $\rightarrow$ 1nn & 1.12 &\\
