# pkg-config file for @PROJECT_NAME@
# add the directory where lib@MAIN_LIBRARY_NAME@.pc is installed to your PKG_CONFIG_PATH
# for example: export PKG_CONFIG_PATH=@PC_FILE_PATH@:${PKG_CONFIG_PATH}

# Then use with :
# pkg-config --cflags --libs lib@MAIN_LIBRARY_NAME@

prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

# info
Name: @PROJECT_NAME@
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Requires:
Requires.private:
Conflicts:

# Compiler line
Cflags: -I${includedir}
# Link line
Libs: -L${libdir} -l@MAIN_LIBRARY_NAME@
Libs.private:
