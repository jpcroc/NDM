      integer :: n3_typ,max_ntyp
      integer,dimension(:,:),allocatable :: m_typ
      integer,dimension(:,:,:),allocatable :: t_typ
      double precision,dimension(2) :: massat
      real(double) :: factor_weight_mass
      public :: w2_rho,w3_rho

      integer :: kernel_type, selection_type, ns_data,i_begin,kelem,seed,max_data
      real(double) :: lambda_krr, lambda_krr_2, min_lambda_krr, max_lambda_krr
      real(double), parameter :: lambda_krr_fake=1.d-8
      integer :: n_values_lambda_krr
      character(len=4) :: regularization_name
      real(double), dimension(:), allocatable :: vector_lambda_krr
      logical :: toy_model, krr_error, debug, build_subdata,write_desc,weighted,rescale,search_hyp
      logical :: marginal_likelihood, desc_forces
      double precision :: n_frac,r0,r_cut,s_max_r,s_min_r,s_max_i,s_min_i
      integer :: lpath
      character(len=60) :: path
      character(len=2) :: pref
      integer :: i_poscar
      integer :: kappa_acd,mc_step
      double precision :: alpha_acd,acd_threshold,ksi_ini,temp_ini,tau
      logical ::acd,acd_fcut,acd_weighted,sparsification,sparsification_by_acd,sparsification_by_entropy, sparsification_by_cur
      logical,dimension(:),allocatable :: reject
      integer :: size_indi2
      !database related
      ! iconf_data = iconf_data_train + iconf_data_test
      integer :: iconf_data, iconf_data_train, iconf_data_test
      integer, dimension(:), allocatable :: db_train, db_test

      character(len=80) :: db_file, db_path
      character(len=4)  :: char_desc
      integer, parameter ::  selection_type_first=1, &
                             selection_type_last=2, &
                             selection_type_random=3, &
                             selection_type_first_start=4
      integer            ::  snap_order
      integer, parameter ::  snap_linear=1, &
                             snap_quadratic=2
      logical :: strict_behler
      integer :: dim_energy, dim_force
      !md_iconf is the corresponding iconf for molecular dynamics and is 1
      integer :: md_iconf
      real(kind(0.d0)) :: sign_stress, sign_stress_big_box
      integer :: snap_fit_type
      integer, parameter :: fit_home_hb=0, &
                            fit_lapack_qr=1, &
                            fit_lapack_qr_constraints=2, &
                            fit_lapack_ortho=3, &
                            fit_lapack_svd=4, &
                            fit_home_regularization = 10
      character(len=2) :: snap_class_constraints
      logical :: train_only

      integer :: mtp_poly_min, mtp_poly_max, mtp_rad_order
      real(double) :: tmp_val_desc_max, val_desc_max

      ! weights optimization
      logical :: optimize_weights, optimize_weights_L1, optimize_weights_L2, optimize_weights_Le
      integer ::  optimize_ga_population
      character(len=80) :: class_no_optimize_weights
      character(len=2), dimension(:), allocatable :: no_class_weights
      integer :: max_iter_optimize_weights
      real(double) :: factor_force_error, factor_energy_error, factor_stress_error
      integer, parameter :: size_periodic_table=109
      type element_periodic_table
        integer :: Z
        character(len=2) :: symbol
        character(len=50) :: name, elec_conf
        real(double) :: mass, frozenp, meltp, density, ionization
      end type element_periodic_table
      type(element_periodic_table), dimension(size_periodic_table)  :: periodic_table_element

      integer :: fix_no_of_elements
      character(len=80) :: weight_per_element,chemical_elements

      CHARACTER(len=2), dimension(:), allocatable :: fix_ch_elements
      real(kind=kind(0.d0)), dimension(:), allocatable :: fix_weighted_for_element
      integer, dimension(:), allocatable :: fix_type_to_periodic
      real(kind=kind(0.d0)), dimension(:), allocatable :: fix_Z_elements, fix_mass_elements
      logical :: lfix_weight_auto




#if(PARAML)
     integer ::   iproc, nb_elements, itempproc
#endif

contains


subroutine gen_param_behler()

   implicit none
  real(double) :: BOHR
  integer :: p_e,p_r, p_l, p_z
  integer, parameter :: dp = kind(1.d0)
  integer :: icount
 ! G2 related ........
  if ((descriptor_type==descriptor_g2) .or. (descriptor_type==descriptor_g2_bispectrum_so4).or.(descriptor_type==descriptor_g2_afs).or.(descriptor_type==descriptor_pow_so4)) then
      g2_dim=n_g2_eta*n_g2_rs
      if (strict_behler) then
         g2_dim=8
      end if
      if (allocated(g2_eta)) deallocate(g2_eta) ; allocate(g2_eta(g2_dim))
      if (allocated(g2_rs )) deallocate(g2_rs ) ; allocate(g2_rs (g2_dim))


      if (strict_behler) then
        BOHR = 0.52917721067d0
        r_cut= 11.338_dp * BOHR
        g2_eta(1)= 0.001_dp / BOHR**2; g2_rs(1)= 0.000_dp * BOHR;
        g2_eta(2)= 0.010_dp / BOHR**2; g2_rs(2)= 0.000_dp * BOHR;
        g2_eta(3)= 0.020_dp / BOHR**2; g2_rs(3)= 0.000_dp * BOHR;
        g2_eta(4)= 0.035_dp / BOHR**2; g2_rs(4)= 0.000_dp * BOHR;
        g2_eta(5)= 0.060_dp / BOHR**2; g2_rs(5)= 0.000_dp * BOHR;
        g2_eta(6)= 0.100_dp / BOHR**2; g2_rs(6)= 0.000_dp * BOHR;
        g2_eta(7)= 0.200_dp / BOHR**2; g2_rs(7)= 0.000_dp * BOHR;
        g2_eta(8)= 0.400_dp / BOHR**2; g2_rs(8)= 0.000_dp * BOHR;


      else

       icount=0
       do p_e=1,n_g2_eta
         do p_r=1,n_g2_rs
            icount = icount + 1
            g2_eta(icount)=1.d-2+dble(p_e-1)*(eta_max_g2-1.d-2)/dble(n_g2_eta-1)
            g2_rs(icount)=0.d0+dble(p_r-1)
         enddo
       enddo
       if (icount /= g2_dim) then
         if (rangml==0) write(6,*) 'Error in ml_in_ndm_module.F90, subroutine gen_param_behler'
         stop 'dimension of g2 is incorrect'
       end if

      end if

  end if

  ! G3 related ........
  if (descriptor_type==descriptor_g3) then
      g3_dim=n_g3_eta*n_g3_zeta*n_g3_lambda
      if (strict_behler) then
         g3_dim=43
      end if
      if (allocated(g3_eta)   ) deallocate(g3_eta   ) ; allocate(g3_eta(g3_dim))
      if (allocated(g3_zeta)  ) deallocate(g3_zeta  ) ; allocate(g3_zeta(g3_dim))
      if (allocated(g3_lambda)) deallocate(g3_lambda) ; allocate(g3_lambda(g3_dim))


      if (strict_behler) then
        BOHR = 0.52917721067d0
        r_cut= 11.338_dp * BOHR

        g3_eta( 1)= 0.0001_dp / BOHR**2; g3_lambda( 1)= -1.000_dp; g3_zeta( 1) =  1.000_dp
        g3_eta( 2)= 0.0001_dp / BOHR**2; g3_lambda( 2)=  1.000_dp; g3_zeta( 2) =  1.000_dp
        g3_eta( 3)= 0.0001_dp / BOHR**2; g3_lambda( 3)= -1.000_dp; g3_zeta( 3) =  2.000_dp
        g3_eta( 4)= 0.0001_dp / BOHR**2; g3_lambda( 4)=  1.000_dp; g3_zeta( 4) =  2.000_dp
        g3_eta( 5)= 0.0030_dp / BOHR**2; g3_lambda( 5)= -1.000_dp; g3_zeta( 5) =  1.000_dp
        g3_eta( 6)= 0.0030_dp / BOHR**2; g3_lambda( 6)=  1.000_dp; g3_zeta( 6) =  1.000_dp
        g3_eta( 7)= 0.0030_dp / BOHR**2; g3_lambda( 7)= -1.000_dp; g3_zeta( 7) =  2.000_dp
        g3_eta( 8)= 0.0030_dp / BOHR**2; g3_lambda( 8)=  1.000_dp; g3_zeta( 8) =  2.000_dp
        g3_eta( 9)= 0.0080_dp / BOHR**2; g3_lambda( 9)= -1.000_dp; g3_zeta( 9) =  1.000_dp
        g3_eta(10)= 0.0080_dp / BOHR**2; g3_lambda(10)=  1.000_dp; g3_zeta(10) =  1.000_dp
        g3_eta(11)= 0.0080_dp / BOHR**2; g3_lambda(11)= -1.000_dp; g3_zeta(11) =  2.000_dp
        g3_eta(12)= 0.0080_dp / BOHR**2; g3_lambda(12)=  1.000_dp; g3_zeta(12) =  2.000_dp
        g3_eta(13)= 0.0150_dp / BOHR**2; g3_lambda(13)= -1.000_dp; g3_zeta(13) =  1.000_dp
        g3_eta(14)= 0.0150_dp / BOHR**2; g3_lambda(14)=  1.000_dp; g3_zeta(14) =  1.000_dp
        g3_eta(15)= 0.0150_dp / BOHR**2; g3_lambda(15)= -1.000_dp; g3_zeta(15) =  2.000_dp
        g3_eta(16)= 0.0150_dp / BOHR**2; g3_lambda(16)=  1.000_dp; g3_zeta(16) =  2.000_dp
        g3_eta(17)= 0.0150_dp / BOHR**2; g3_lambda(17)= -1.000_dp; g3_zeta(17) =  4.000_dp
        g3_eta(18)= 0.0150_dp / BOHR**2; g3_lambda(18)=  1.000_dp; g3_zeta(18) =  4.000_dp
        g3_eta(19)= 0.0150_dp / BOHR**2; g3_lambda(19)= -1.000_dp; g3_zeta(19) = 16.000_dp
        g3_eta(20)= 0.0150_dp / BOHR**2; g3_lambda(20)=  1.000_dp; g3_zeta(20) = 16.000_dp
        g3_eta(21)= 0.0250_dp / BOHR**2; g3_lambda(21)= -1.000_dp; g3_zeta(21) =  1.000_dp
        g3_eta(22)= 0.0250_dp / BOHR**2; g3_lambda(22)=  1.000_dp; g3_zeta(22) =  1.000_dp
        g3_eta(23)= 0.0250_dp / BOHR**2; g3_lambda(23)= -1.000_dp; g3_zeta(23) =  2.000_dp
        g3_eta(24)= 0.0250_dp / BOHR**2; g3_lambda(24)=  1.000_dp; g3_zeta(24) =  2.000_dp
        g3_eta(25)= 0.0250_dp / BOHR**2; g3_lambda(25)= -1.000_dp; g3_zeta(25) =  4.000_dp
        g3_eta(26)= 0.0250_dp / BOHR**2; g3_lambda(26)=  1.000_dp; g3_zeta(26) =  4.000_dp
        g3_eta(27)= 0.0250_dp / BOHR**2; g3_lambda(27)= -1.000_dp; g3_zeta(27) = 16.000_dp
        g3_eta(28)= 0.0250_dp / BOHR**2; g3_lambda(28)=  1.000_dp; g3_zeta(28) = 16.000_dp
        g3_eta(29)= 0.0450_dp / BOHR**2; g3_lambda(29)= -1.000_dp; g3_zeta(29) =  1.000_dp
        g3_eta(30)= 0.0450_dp / BOHR**2; g3_lambda(30)=  1.000_dp; g3_zeta(30) =  1.000_dp
        g3_eta(31)= 0.0450_dp / BOHR**2; g3_lambda(31)= -1.000_dp; g3_zeta(31) =  2.000_dp
        g3_eta(32)= 0.0450_dp / BOHR**2; g3_lambda(32)=  1.000_dp; g3_zeta(32) =  2.000_dp
        g3_eta(33)= 0.0450_dp / BOHR**2; g3_lambda(33)= -1.000_dp; g3_zeta(33) =  4.000_dp
        g3_eta(34)= 0.0450_dp / BOHR**2; g3_lambda(34)=  1.000_dp; g3_zeta(34) =  4.000_dp
        g3_eta(35)= 0.0450_dp / BOHR**2; g3_lambda(35)= -1.000_dp; g3_zeta(35) = 16.000_dp
        g3_eta(36)= 0.0450_dp / BOHR**2; g3_lambda(36)=  1.000_dp; g3_zeta(36) = 16.000_dp
        g3_eta(37)= 0.0800_dp / BOHR**2; g3_lambda(37)= -1.000_dp; g3_zeta(37) =  1.000_dp
        g3_eta(38)= 0.0800_dp / BOHR**2; g3_lambda(38)=  1.000_dp; g3_zeta(38) =  1.000_dp
        g3_eta(39)= 0.0800_dp / BOHR**2; g3_lambda(39)= -1.000_dp; g3_zeta(39) =  2.000_dp
        g3_eta(40)= 0.0800_dp / BOHR**2; g3_lambda(40)=  1.000_dp; g3_zeta(40) =  2.000_dp
        g3_eta(41)= 0.0800_dp / BOHR**2; g3_lambda(41)= -1.000_dp; g3_zeta(41) =  4.000_dp
        g3_eta(42)= 0.0800_dp / BOHR**2; g3_lambda(42)=  1.000_dp; g3_zeta(42) =  4.000_dp
        g3_eta(43)= 0.0800_dp / BOHR**2; g3_lambda(43)=  1.000_dp; g3_zeta(43) = 16.000_dp

      else
       icount=0
       do p_e=1,n_g3_eta
         do p_l=1,n_g3_lambda
            do p_z=1,n_g3_zeta
                icount=icount+1
                g3_eta(icount)=1.d-2+dble(p_e-1)*(0.80d0-1.d-2)/dble(n_g3_eta-1)
                g3_lambda(icount)=-1.d0+dble(p_l-1)*2.d0
                g3_zeta(icount)=2.d0**(p_z-1)
            enddo
         enddo
       enddo


       if (icount /= g3_dim) then
         if (rangml==0) write(6,*) 'Error in ml_in_ndm_module.F90, subroutine gen_param_behler'
         stop 'dimension of g2 is incorrect'
       end if
      end if



  end if
  !Behler related ....
  if (descriptor_type==descriptor_behler) then
      g2_dim=n_g2_eta*n_g2_rs
      g3_dim=n_g3_eta*n_g3_zeta*n_g3_lambda
      if (strict_behler) then
         g2_dim=8
         g3_dim=43
      end if
      behler_dim=g2_dim+g3_dim
      if (allocated(g2_eta)) deallocate(g2_eta)  ; allocate(g2_eta(g2_dim))
      if (allocated(g2_rs) ) deallocate(g2_rs )  ; allocate(g2_rs(g2_dim))

      if (allocated(g3_eta)   ) deallocate(g3_eta   ) ; allocate(g3_eta(g3_dim))
      if (allocated(g3_zeta)  ) deallocate(g3_zeta  ) ; allocate(g3_zeta(g3_dim))
      if (allocated(g3_lambda)) deallocate(g3_lambda) ; allocate(g3_lambda(g3_dim))

      if (strict_behler) then
        BOHR = 0.52917721067d0
        r_cut= 11.338_dp * BOHR
        g2_eta(1)= 0.001_dp / BOHR**2; g2_rs(1)= 0.000_dp * BOHR;
        g2_eta(2)= 0.010_dp / BOHR**2; g2_rs(2)= 0.000_dp * BOHR;
        g2_eta(3)= 0.020_dp / BOHR**2; g2_rs(3)= 0.000_dp * BOHR;
        g2_eta(4)= 0.035_dp / BOHR**2; g2_rs(4)= 0.000_dp * BOHR;
        g2_eta(5)= 0.060_dp / BOHR**2; g2_rs(5)= 0.000_dp * BOHR;
        g2_eta(6)= 0.100_dp / BOHR**2; g2_rs(6)= 0.000_dp * BOHR;
        g2_eta(7)= 0.200_dp / BOHR**2; g2_rs(7)= 0.000_dp * BOHR;
        g2_eta(8)= 0.400_dp / BOHR**2; g2_rs(8)= 0.000_dp * BOHR;

        g3_eta( 1)= 0.0001_dp / BOHR**2; g3_lambda( 1)= -1.000_dp; g3_zeta( 1) =  1.000_dp
        g3_eta( 2)= 0.0001_dp / BOHR**2; g3_lambda( 2)=  1.000_dp; g3_zeta( 2) =  1.000_dp
        g3_eta( 3)= 0.0001_dp / BOHR**2; g3_lambda( 3)= -1.000_dp; g3_zeta( 3) =  2.000_dp
        g3_eta( 4)= 0.0001_dp / BOHR**2; g3_lambda( 4)=  1.000_dp; g3_zeta( 4) =  2.000_dp
        g3_eta( 5)= 0.0030_dp / BOHR**2; g3_lambda( 5)= -1.000_dp; g3_zeta( 5) =  1.000_dp
        g3_eta( 6)= 0.0030_dp / BOHR**2; g3_lambda( 6)=  1.000_dp; g3_zeta( 6) =  1.000_dp
        g3_eta( 7)= 0.0030_dp / BOHR**2; g3_lambda( 7)= -1.000_dp; g3_zeta( 7) =  2.000_dp
        g3_eta( 8)= 0.0030_dp / BOHR**2; g3_lambda( 8)=  1.000_dp; g3_zeta( 8) =  2.000_dp
        g3_eta( 9)= 0.0080_dp / BOHR**2; g3_lambda( 9)= -1.000_dp; g3_zeta( 9) =  1.000_dp
        g3_eta(10)= 0.0080_dp / BOHR**2; g3_lambda(10)=  1.000_dp; g3_zeta(10) =  1.000_dp
        g3_eta(11)= 0.0080_dp / BOHR**2; g3_lambda(11)= -1.000_dp; g3_zeta(11) =  2.000_dp
        g3_eta(12)= 0.0080_dp / BOHR**2; g3_lambda(12)=  1.000_dp; g3_zeta(12) =  2.000_dp
        g3_eta(13)= 0.0150_dp / BOHR**2; g3_lambda(13)= -1.000_dp; g3_zeta(13) =  1.000_dp
        g3_eta(14)= 0.0150_dp / BOHR**2; g3_lambda(14)=  1.000_dp; g3_zeta(14) =  1.000_dp
        g3_eta(15)= 0.0150_dp / BOHR**2; g3_lambda(15)= -1.000_dp; g3_zeta(15) =  2.000_dp
        g3_eta(16)= 0.0150_dp / BOHR**2; g3_lambda(16)=  1.000_dp; g3_zeta(16) =  2.000_dp
        g3_eta(17)= 0.0150_dp / BOHR**2; g3_lambda(17)= -1.000_dp; g3_zeta(17) =  4.000_dp
        g3_eta(18)= 0.0150_dp / BOHR**2; g3_lambda(18)=  1.000_dp; g3_zeta(18) =  4.000_dp
        g3_eta(19)= 0.0150_dp / BOHR**2; g3_lambda(19)= -1.000_dp; g3_zeta(19) = 16.000_dp
        g3_eta(20)= 0.0150_dp / BOHR**2; g3_lambda(20)=  1.000_dp; g3_zeta(20) = 16.000_dp
        g3_eta(21)= 0.0250_dp / BOHR**2; g3_lambda(21)= -1.000_dp; g3_zeta(21) =  1.000_dp
        g3_eta(22)= 0.0250_dp / BOHR**2; g3_lambda(22)=  1.000_dp; g3_zeta(22) =  1.000_dp
        g3_eta(23)= 0.0250_dp / BOHR**2; g3_lambda(23)= -1.000_dp; g3_zeta(23) =  2.000_dp
        g3_eta(24)= 0.0250_dp / BOHR**2; g3_lambda(24)=  1.000_dp; g3_zeta(24) =  2.000_dp
        g3_eta(25)= 0.0250_dp / BOHR**2; g3_lambda(25)= -1.000_dp; g3_zeta(25) =  4.000_dp
        g3_eta(26)= 0.0250_dp / BOHR**2; g3_lambda(26)=  1.000_dp; g3_zeta(26) =  4.000_dp
        g3_eta(27)= 0.0250_dp / BOHR**2; g3_lambda(27)= -1.000_dp; g3_zeta(27) = 16.000_dp
        g3_eta(28)= 0.0250_dp / BOHR**2; g3_lambda(28)=  1.000_dp; g3_zeta(28) = 16.000_dp
        g3_eta(29)= 0.0450_dp / BOHR**2; g3_lambda(29)= -1.000_dp; g3_zeta(29) =  1.000_dp
        g3_eta(30)= 0.0450_dp / BOHR**2; g3_lambda(30)=  1.000_dp; g3_zeta(30) =  1.000_dp
        g3_eta(31)= 0.0450_dp / BOHR**2; g3_lambda(31)= -1.000_dp; g3_zeta(31) =  2.000_dp
        g3_eta(32)= 0.0450_dp / BOHR**2; g3_lambda(32)=  1.000_dp; g3_zeta(32) =  2.000_dp
        g3_eta(33)= 0.0450_dp / BOHR**2; g3_lambda(33)= -1.000_dp; g3_zeta(33) =  4.000_dp
        g3_eta(34)= 0.0450_dp / BOHR**2; g3_lambda(34)=  1.000_dp; g3_zeta(34) =  4.000_dp
        g3_eta(35)= 0.0450_dp / BOHR**2; g3_lambda(35)= -1.000_dp; g3_zeta(35) = 16.000_dp
        g3_eta(36)= 0.0450_dp / BOHR**2; g3_lambda(36)=  1.000_dp; g3_zeta(36) = 16.000_dp
        g3_eta(37)= 0.0800_dp / BOHR**2; g3_lambda(37)= -1.000_dp; g3_zeta(37) =  1.000_dp
        g3_eta(38)= 0.0800_dp / BOHR**2; g3_lambda(38)=  1.000_dp; g3_zeta(38) =  1.000_dp
        g3_eta(39)= 0.0800_dp / BOHR**2; g3_lambda(39)= -1.000_dp; g3_zeta(39) =  2.000_dp
        g3_eta(40)= 0.0800_dp / BOHR**2; g3_lambda(40)=  1.000_dp; g3_zeta(40) =  2.000_dp
        g3_eta(41)= 0.0800_dp / BOHR**2; g3_lambda(41)= -1.000_dp; g3_zeta(41) =  4.000_dp
        g3_eta(42)= 0.0800_dp / BOHR**2; g3_lambda(42)=  1.000_dp; g3_zeta(42) =  4.000_dp
        g3_eta(43)= 0.0800_dp / BOHR**2; g3_lambda(43)=  1.000_dp; g3_zeta(43) = 16.000_dp

      else

         icount=0
         do p_e=1,n_g2_eta
           do p_r=1,n_g2_rs
              icount = icount + 1
              g2_eta(icount)=1.d-2+dble(p_e-1)*(eta_max_g2-1.d-2)/dble(n_g2_eta-1)
              g2_rs(icount)=0.d0+dble(p_r-1)
           enddo
         enddo

         icount=0
         do p_e=1,n_g3_eta
           do p_l=1,n_g3_lambda
             do p_z=1,n_g3_zeta
                icount=icount+1
                g3_eta(icount)=1.d-2+dble(p_e-1)*(0.08d0-1.d-2)/dble(n_g3_eta-1)
                g3_lambda(icount)=-1.d0+dble(p_l-1)*2.d0
                g3_zeta(icount)=2.d0**(p_z-1)
             enddo
           enddo
         enddo
       end if
 end if

return
end subroutine gen_param_behler


subroutine typ(n2_typ,n3_typ)
use var_pot, only : ntyp
implicit none
integer,intent(out) :: n2_typ
integer,intent(out) :: n3_typ

if (.not.weighted) then
   n2_typ=ntyp*(ntyp+1)/2
   n3_typ=ntyp*(ntyp+1)*(ntyp+2)/6
else
   n2_typ=1
   n3_typ=1
endif

return
end subroutine typ


subroutine allocate_ml()

 implicit none

 call typ(n2_typ,n3_typ)

 select case(descriptor_type)
  case (descriptor_g2)
    if (allocated(g2))       deallocate(g2)       ; allocate(g2(g2_dim, imm))
    if (allocated(g2_deriv)) deallocate(g2_deriv) ; allocate(g2_deriv(g2_dim, imm, 0:imm_neigh, 3))
  case (descriptor_g3)
    if (allocated(g3))       deallocate(g3)       ; allocate (g3(g3_dim, imm))
    if (allocated(g3_deriv)) deallocate(g3_deriv) ; allocate(g3_deriv(g3_dim, imm, 0:imm_neigh, 3))
  case (descriptor_behler)
    if (allocated(g2))       deallocate(g2)       ; allocate(g2(g2_dim, imm))
    if (allocated(g2_deriv)) deallocate(g2_deriv) ; allocate (g2_deriv(g2_dim, imm, 0:imm_neigh, 3))
    if (allocated(g3))       deallocate(g3)       ; allocate (g3(g3_dim, imm))
    if (allocated(g3_deriv)) deallocate(g3_deriv) ; allocate(g3_deriv(g3_dim, imm, 0:imm_neigh, 3))

  case (descriptor_afs)
    !if (allocated(afs)) deallocate(afs)             ;   allocate(afs(afs_dim,imm))
    !if (allocated(afs_deriv)) deallocate(afs_deriv) ;  allocate(afs_deriv(afs_dim,imm,0:imm_neigh, 3))

  case (descriptor_g2_afs)
    !if (allocated(g2))       deallocate(g2)         ; allocate(g2(g2_dim, imm))
    !if (allocated(g2_deriv)) deallocate(g2_deriv)   ; allocate(g2_deriv(g2_dim, imm, 0:imm_neigh, 3))
    !if (allocated(afs)) deallocate(afs)             ; allocate(afs(afs_dim,imm))
    !if (allocated(afs_deriv)) deallocate(afs_deriv) ; allocate(afs_deriv(afs_dim,imm,0:imm_neigh, 3))


  case (descriptor_soap)
    !if (allocated(soap)) deallocate(soap) ; allocate(soap(soap_dim, imm))
    !if (allocated(soap_deriv)) deallocate(soap_deriv) ; allocate(soap_deriv(soap_dim, imm, 0:imm_neigh, 3))

  case (descriptor_pow_so3)
    if (allocated(pow_so3)) deallocate(pow_so3) ;  allocate(pow_so3(pow_so3_dim,imm))
    if (allocated(pow_so3_deriv)) deallocate(pow_so3_deriv) ; allocate(pow_so3_deriv(pow_so3_dim, imm, 0:imm_neigh, 3))

  case (descriptor_bispectrum_so3)
    !if (allocated(bispectrum_so3)) deallocate(bispectrum_so3); allocate(bispectrum_so3(bisso3_dim, imm))
    !if (allocated(bispectrum_so3_deriv)) deallocate(bispectrum_so3_deriv) ; allocate(bispectrum_so3_deriv(bisso3_dim, imm, 0:imm_neigh,3))

  case (descriptor_pow_so4)
    if (allocated(pow_so4))  deallocate(pow_so4) ; allocate(pow_so4(0:jj_max,imm)   )
    if (allocated(pow_so4_deriv)) deallocate(pow_so4_deriv); allocate(pow_so4_deriv(0:jj_max,imm, 0:imm_neigh,3))
  case (descriptor_g2_pow_so4)
    if (allocated(g2))       deallocate(g2)       ; allocate(g2(g2_dim, imm))
    if (allocated(g2_deriv)) deallocate(g2_deriv) ; allocate(g2_deriv(g2_dim, imm, 0:imm_neigh, 3))
    if (allocated(pow_so4))  deallocate(pow_so4) ; allocate(pow_so4(0:jj_max,imm)   )
    if (allocated(pow_so4_deriv)) deallocate(pow_so4_deriv); allocate(pow_so4_deriv(0:jj_max,imm, 0:imm_neigh,3))
  case (descriptor_bispectrum_so4)
    !if (allocated(bispectrum_so4))       deallocate(bispectrum_so4)      ; allocate(bispectrum_so4(bisso4_dim, imm))
    !if (allocated(bispectrum_so4_deriv)) deallocate(bispectrum_so4_deriv); allocate(bispectrum_so4_deriv(bisso4_dim, imm, 0:imm_neigh,3))

  case (descriptor_mtp)
    !if (allocated(mtp))       deallocate(mtp)      ; allocate(mtp(mtp_dim, imm))
    !if (allocated(mtp_deriv)) deallocate(mtp_deriv); allocate(mtp_deriv(mtp_dim, imm, 0:imm_neigh,3))

  case (descriptor_g2_bispectrum_so4)
    if (allocated(bispectrum_so4))       deallocate(bispectrum_so4)      ; allocate(bispectrum_so4(bisso4_dim, imm))
    if (allocated(bispectrum_so4_deriv)) deallocate(bispectrum_so4_deriv); allocate(bispectrum_so4_deriv(bisso4_dim, imm, 0:imm_neigh,3))
    if (allocated(g2))       deallocate(g2)       ; allocate(g2(g2_dim, imm))
    if (allocated(g2_deriv)) deallocate(g2_deriv) ; allocate(g2_deriv(g2_dim, imm, 0:imm_neigh, 3))

  case (descriptor_magnetic_sld)
  case (descriptor_magnetic_sld_afs)

  case default
       if (rangml==0) write(6,*) 'No implementation for descriptor_type...', descriptor_type
       if (rangml==0) write(6,*) ' File: ml_in_ndm_module.F90, Subroutine: allocate_ml'
       stop
end select

return
end subroutine allocate_ml




subroutine deallocate_ml()
implicit none

 select case(descriptor_type)
  case (descriptor_g2)
    deallocate(g2,g2_deriv)
  case (descriptor_g3)
    deallocate(g3,g3_deriv)
  case (descriptor_behler)
    deallocate(g2,g2_deriv,g3,g3_deriv)

  case (descriptor_afs)
    if (allocated(afs)) deallocate(afs)
    if (allocated(afs_deriv)) deallocate(afs_deriv)

  case (descriptor_g2_afs)
    if (allocated(g2)) deallocate(g2)
    if (allocated(g2_deriv)) deallocate(g2_deriv)
    if (allocated(afs)) deallocate(afs)
    if (allocated(afs_deriv)) deallocate(afs_deriv)

  case (descriptor_soap)
     if (allocated(soap))        deallocate(soap)
     if (allocated(soap_deriv))  deallocate(soap_deriv)
  case (descriptor_pow_so3)
    deallocate(pow_so3,pow_so3_deriv)

  case (descriptor_bispectrum_so3)
    if (allocated(bispectrum_so3))  deallocate(bispectrum_so3)
    if (allocated(bispectrum_so3_deriv))  deallocate(bispectrum_so3_deriv)

  case (descriptor_pow_so4)
    deallocate(pow_so4,pow_so4_deriv)

  case (descriptor_g2_pow_so4)
    if (allocated(g2)) deallocate(g2)
    if (allocated(g2_deriv)) deallocate(g2_deriv)
    if (allocated(pow_so4))  deallocate(pow_so4)
    if (allocated(pow_so4_deriv))  deallocate(pow_so4_deriv)

    deallocate(g2,g2_deriv)
    deallocate(pow_so4,pow_so4_deriv)

  case (descriptor_bispectrum_so4)
    if (allocated(bispectrum_so4))  deallocate(bispectrum_so4)
    if (allocated(bispectrum_so4_deriv))  deallocate(bispectrum_so4_deriv)

  case (descriptor_mtp)
    if (allocated(mtp)) deallocate(mtp)
    if (allocated(mtp_deriv)) deallocate(mtp_deriv)

 case (descriptor_g2_bispectrum_so4)
    if (allocated(g2)) deallocate(g2)
    if (allocated(g2_deriv)) deallocate(g2_deriv)
    if (allocated(bispectrum_so4))  deallocate(bispectrum_so4)
    if (allocated(bispectrum_so4_deriv))  deallocate(bispectrum_so4_deriv)

  case (descriptor_magnetic_sld)
    if (allocated(magnetic_sld))  deallocate(magnetic_sld)
    if (allocated(magnetic_sld_deriv))  deallocate(magnetic_sld_deriv)

  case (descriptor_magnetic_sld_afs)
    if (allocated(magnetic_sld))  deallocate(magnetic_sld)
    if (allocated(magnetic_sld_deriv))  deallocate(magnetic_sld_deriv)
    if (allocated(afs)) deallocate(afs)
    if (allocated(afs_deriv)) deallocate(afs_deriv)

  case default
       if (rangml==0) write(6,*) 'No implementation for descriptor_type...', descriptor_type
       if (rangml==0) write(6,*) 'File: ml_in_ndm_module.F90, Subroutine: deallocate_ml'
       stop
end select

return
end subroutine deallocate_ml



subroutine mconf(m_typ)
implicit none
integer :: c,i,j
integer,dimension(ntyp,ntyp),intent(out) :: m_typ

m_typ(:,:)=0
c=0
do i=1,ntyp
   do j=i,ntyp
      c=c+1
      m_typ(i,j)=c
      m_typ(j,i)=c
   enddo
enddo

return
end subroutine mconf




subroutine tconf(t_typ)
implicit none
integer :: c,i,j,k
integer,dimension(ntyp,ntyp,ntyp),intent(out) :: t_typ

t_typ(:,:,:)=0
c=0
do i=1,ntyp
   do j=i,ntyp
      do k=j,ntyp
         c=c+1
         t_typ(i,j,k)=c
         t_typ(j,i,k)=c
         t_typ(k,j,i)=c
         t_typ(i,k,j)=c
         t_typ(j,k,i)=c
         t_typ(k,i,j)=c
      enddo
   enddo
enddo

return
end subroutine tconf


function w2_rho(mi,mj)
implicit none
double precision :: mi,mj,w2_rho

w2_rho=mi+mj

end function w2_rho

function w3_rho(mi,mj,mk)

implicit none

double precision :: mi,mj,mk,w3_rho

w3_rho=mi+mj+mk
end function w3_rho



subroutine rotate(a,x,y)
implicit none
double precision,dimension(3),intent(in) :: a
double precision,dimension(3),intent(in) :: x
double precision,dimension(3),intent(out) :: y
double precision,dimension(3,3) :: rotx,rotz1,rotz2

call mat_rotx(a(2)*pi,rotx)
call mat_rotz(a(1)*2*pi,rotz1)
call mat_rotz(a(3)*2*pi,rotz2)

y=matmul(rotz2,matmul(rotx,matmul(rotz1,x)))

return
end subroutine rotate



subroutine mat_rotx(angle,rotx)
implicit none
double precision,intent(in) :: angle
double precision,dimension(3,3),intent(out) :: rotx

rotx(1,1)=1
rotx(1,2)=0
rotx(1,3)=0
rotx(2,1)=0
rotx(2,2)=cos(angle)
rotx(2,3)=-sin(angle)
rotx(3,1)=0
rotx(3,2)=sin(angle)
rotx(3,3)=cos(angle)

return
end subroutine mat_rotx

subroutine mat_rotz(angle,rotz)
implicit none
double precision,intent(in) :: angle
double precision,dimension(3,3),intent(out) :: rotz

rotz(1,1)=cos(angle)
rotz(1,2)=-sin(angle)
rotz(1,3)=0
rotz(2,1)=sin(angle)
rotz(2,2)=cos(angle)
rotz(2,3)=0
rotz(3,1)=0
rotz(3,2)=0
rotz(3,3)=1

return
end subroutine mat_rotz




