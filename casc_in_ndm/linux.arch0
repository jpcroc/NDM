


# link library
LIBRARY =

 
ifdef PARA
 # Version Parallele
 #
 F90      = mpif90
 CPPFLAGS = -C -P -traditional -DPARA
 EXT      = _para
#F90FLAGS = -O0 -g -C
F90FLAGS = -O3 

else
 # Version sequentielle
 #
#version tantale
# F90 = pgf90#
#version platine
# F90 = ifort
# CPPFLAGS = -C -P -traditional
# EXT      = _seq
#version SRMP
 F90 = ifort
 CPPFLAGS = -C -P -traditional
 EXT      = 
#F90FLAGS =  -O0 -fpe0 -C -traceback -warn all -u -fpstkchk -ftrapuv -warn all	# Debuggage pas pour de rire
#F90FLAGS = -O0 -g -C
F90FLAGS = -O3 

endif

ifdef DECOUP
 # Code sequentiel pour evaluer le decoupage en sous-domaines
 #
 CPPFLAGS+= -DDECOUP
 ifdef PARA
  EXT = _para_decoup
 else
  EXT = _seq_decoup
 endif
endif
 
CPP = /usr/bin/cpp
LD = ${F90}



ifdef ART
 F90 = ifort
 CPPFLAGS = -C -P -traditional -DART
 EXT      = _ART
#F90FLAGS =  -O0 -fpe0 -C -traceback -warn all -u -fpstkchk -ftrapuv -warn all	# Debuggage pas pour de rire
#F90FLAGS = -static -O0 -g -C
F90FLAGS = -static -O3 

#FLAGS and LIBS for ART
FLAGS_ART =  -DNOIBM 
F90FLAGS_ART = -C -module ../ $(F90FLAGS) $(FLAGS) 
F77FLAGS_ART = -C $(F90FLAGS) $(FLAGS) 
FFLAGS =  
LLIBS_ART = -L/opt/intel/mkl/8.0.1/lib/32/  -lmkl_lapack  -lguide  -lpthread -lmkl_ia32 
# link library
LIBRARY_ART = art/libart.a


# link library
LIBRARY =${LIBRARY_ART} ${LLIBS_ART}  

endif