 &input
	tstep=1.0
        igen=0 !(*) =0 lecture .gin; =1 lecture .cin/cout 
	imm=1200 !(*) nombre max d'atomes (taille des tableaux
	dmtype=4 !(*) type de DM (4= Velocity Verlet; 3= GC ; 2=trempe rapide
	tinit=300.0000! (*) si .gin	! temperature initiale
	itesigma=1,ntyp=3
	itmax=10 ! (*)nombre max d'itarations
	lpotentiel(7)=.true.,lpotentiel(16)=.true. ! (*) type de potentiel
	itetemp=1 ! periode d'ecriture de la température 
	leEv=.true., lPKbar=.true. ! energies en eV ; pression kbar
	itesauv =10 !period d'écriture du fichiers .cout (écrase le pr précédent)
	iseed=112 ! graine aléatoire (si pas précisé= horloge machine)
	itetabvois=1000
	ltabvois = .false.  ! table des voisins et rayon de coupure!	ltabvois=.false.
	iterasmol=1000, ivisu=4
&end
	! lpr=.true.,sigstop=0.001

fpstop =0.05 ! force max sur atome pour arrêt relaxation (eV/Ang)
fmsumstop = 0.1 ! force totale pour arrêt relaxation (eV/ang)

itesauvposition =10 !période de sauvegarde des positions seules (.cout najoute des ficheirs
lWgin =.true. écrit un fichier .newgin à la fin
tempdeplainit=300.0,debyetemp=398.0 ! déplacement initial

ltabvois = .true. , rvois = 12.7 ! table des voisins et rayon de coupure
itetabvois=10 ! période de recalcul de la table des voisins.

lrestart=.true. ! lit un fichier .cout

lpr=.true. !Pcst
lpcon2=.true. !amortisseur ds oscillations de boite
lThoover=.true. ! T constante à la Hoover (il en existe plusieurs autres)
