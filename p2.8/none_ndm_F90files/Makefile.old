#F90FLAGS =    -static -O3 
# OPTIONS CLOUET 
#F90FLAGS =  -O0 -fpe0 -C -traceback -warn all -u -fpstkchk -ftrapuv -warn all



#F90 = pgf90
#F90FLAGS = -O0 -C -g

#F90 = pathf90
#F90FLAGS = -O0 -C -g 

