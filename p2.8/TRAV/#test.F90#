    !call calfoprec(xp)
  end subroutine calfo
end module calfo_mod

program test
  use deftypes
  use calfo_mod
  use posmoy
  type(atomtype)::at1
  type(atomdyntype)::at2
  type(atomdynexempletype)::at3,at3b
  at1%xp(:)=0.
!  at2%xp(:)=0.
  at3%xp(:)=0.
!  at2%vp(:)=1.
  at3%vp(:)=1.
  at3%posmoy=2.
!  at2=at1
  at2=atomdyntype(atomtype=at1,xpp=7.,vp=8.,ax=9)
  at3=atomdynExempletype(atomtype=at1,xpp=10.,vp=11.,ax=12,posmoy=13)
  at3b=atomdynExempletype(atomdyntype=at2,posmoy=14)
  call calfo(at1)
  call calfo(at2)
  call calfo(at3)
  call calfo(at3b)
  write(6,*)at1
