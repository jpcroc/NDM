subroutine divid (appel)
  !-----------------------------------------------
  !   M o d u l e s
  !-----------------------------------------------
  USE T_kind_param_m, ONLY:  double
  use gen_com_m
  use tab_imm_m
  implicit none
  !-----------------------------------------------
  !   D u m m y   A r g u m e n t s
  !-----------------------------------------------
  integer , intent(in) :: appel ! 0: appel partiel juste pour calcul nox/y/z
  ! 1: appel de la routine complete
  !-----------------------------------------------
  !   L o c a l   V a r i a b l e s
  !-----------------------------------------------
  real(double) :: celmin, zlmin, zlm2
  integer::izonr2,izonr
  real(double)::voluperat,rm2,qtot

  !-----------------------------------------------
  !   E x t e r n a l   F u n c t i o n s
  !-----------------------------------------------
  real(double) , external :: distmin, calcvol
  !-----------------------------------------------

  if (rang.eq.0) then
     write(6,*)
     write(6,*)' -------------------------------------------------------------------'
     write(6,*)'             definition des rayons de coupure'
  endif

  select case (ipotentiel)
  case(0,1,3,4,5)
     call param_det  !Determination des paramtres pour la sommation d'Ewald.
  end select

  if(rang==0)      write(6,*) 'rumax,rue',rumax ,rue
  rumax = max(rumax,rue)
  if (rulayer==0.0) rulayer=rumax
  !     if(l3c) then
  if (r3cm.eq.0) r3cm=5.0d-8
  itab=1
  r3cm2=r3cm**2
  !     endif
  !if(rang==0)         write (6, *) ' rvois  ', rvois
  csive = rue/float(ngrid)
  if (ltabvois) then
     if (rumax>rvois) then
        if(rang==0) write (6, *) ' rvois trop petit rvois rumax ', rvois, rumax
        call arret_ndm
     endif
     if(.not.lconstrtot)rumax=rvois
  endif
  ! MPI
  !      if (rang==0) write (6, *) '---- def rayon coupure ok -----'
  !calcul de zlmin
       zlmin = distmin(at(1,1),at(1,2))
       zlm2 = distmin(at(1,1),at(1,3))
       zlmin = min(zlmin,zlm2)
       zlm2 = distmin(at(1,2),at(1,3))
       zlmin = min(zlmin,zlm2)

  izonr = int(zlmin/rumax)
  ! MPI
  if (rang==0) write (6, *) 'izonr,zlmin,rumax', izonr, zlmin, rumax
  if (izonr<1) then
     write (6, *) 'trop petite boite !!!'
     stop
  endif
  ! calcul du volume
  !      if (rang==0) write (6, *) 'avant volu'

  volu = calcvol(at(1,1),at(1,2),at(1,3))

  if (rang==0) then 
     write (6, '(A,D10.3,A,D10.3,A)') 'volume=', volu,' cm3 ',volu*1d24,' Ang3'
  end if


  !DETERMINATION DE NOX NOY NOZ     

  if (rang==0) write (6, *) 'nox,noy,noz dans .din =', nox, noy, noz

  if (nox<=0.or.noy<=0.or.noz<=0) then
     ! dÃ©termination de nox noy noz qui ne sont pas donnes dans .din
     ! 
     if (rang==0) write (6, *) 'calcul de nox noy noz !!!'
     if (izonr<3) then

        ltabvois = .TRUE.
        lconstrtot=.TRUE.
#ifdef PARA
        write(6,*)'trop petite boite pour para'
        call arret_ndm

#endif
        nox = 1
        noy = 1
        noz = 1
        if (rang==0) then
           write (6, *) 'plus de cellules, on considere toute la boite '
        endif
     else
        nox = int(nzl(1)/rumax)
        noy = int(nzl(2)/rumax)
        noz = int(nzl(3)/rumax)
        if (rang==0) write (6, *) 'nox noy noz calcules a partir de ru = '&
             , nox, noy, noz
     endif
     celsize(1) = zl(1)/float(nox)
     celsize(2) = zl(2)/float(noy)
     celsize(3) = zl(3)/float(noz)

  else

     ! *** nox noy noz sont donnes dans.din ***

     if (nox==2.or.noy==2.or.noz==2) then
        write (6, *) rang,'wrong noxyz stop'
        call arret_ndm
     endif
     if (nox==1.or.noy==1.or.noz==1) then
        if (rang==0)  write (6, *) 'plus de cellules, on considere toute la boite'            
        ltabvois = .TRUE.
        lconstrtot=.TRUE.
        nox = 1
        noy = 1
        noz = 1
     endif

     celsize(1) = zl(1)/float(nox)
     celsize(2) = zl(2)/float(noy)
     celsize(3) = zl(3)/float(noz)
     celmin = min(celsize(1),celsize(2))
     celmin = min(celsize(3),celmin)
     if (celmin<=rumax) then
        write (6, *) 'changement de nox noy noz !!!'
        if (izonr<3) then
           ltabvois = .TRUE.
           lconstrtot=.TRUE.
           nox = 1
           noy = 1
           noz = 1
           if (rang==0) then
              write (6, *) 'plus de cellules, on considere toute la boite'

           endif
        else
           nox = int(nzl(1)/rumax)
           noy = int(nzl(2)/rumax)
           noz = int(nzl(3)/rumax)
           if (rang==0) write (6, *) &
                'nox noy noz calcules a partir de ru = ', nox, noy, noz
        endif
        celsize(1) = zl(1)/float(nox)
        celsize(2) = zl(2)/float(noy)
        celsize(3) = zl(3)/float(noz)
        !        write(6,*)'celsize ok '
     endif

  endif
  ! nox noy et noz sont determines

  noxy = nox*noy
  noxyz = nox*noy*noz

  if (appel==0) return

  natperc= INT(im_glob/noxyz)
  nvat=10*natperc
  if(natperc.le.2)then
     if (rang==0) &
          write(6,*) 'moins de 3 atomes par celulle -> ENVISAGEZ UN CALCUL EN table des voisins ' 
!     ltabvois=.TRUE. ; lconstrtot=.TRUE.
  end if

  natperc=max(2*natperc,10)

  if (rang==0) &
       write(6,*) 'natperc im/noxyz', natperc, im_glob/noxyz

  if (rang==0)  write(6,*)'ltabvois,lconstrtot',ltabvois,lconstrtot

  if (ltabvois) then
     if (rumax>rvois) then
        write (6, *) rang,' rvois trop petit rvois rumax ', rvois, rumax
        call arret_ndm
     endif
     !crc        rm2=max(rumax,2*rvois)
     rm2=max(rumax,rvois)
     izonr2 = int(zlmin/rm2)
     if (izonr2<1) then
        write (6, *) rang,'trop petite boite pour rvois !!!'
        call arret_ndm
     endif
     if(.not.lconstrtot)rumax=rvois
     voluperat=volu/im
     IF (nvperat.LE.0) nvperat=4*Pi*(rvois+1.0d-8)**3/(3*voluperat)
     if(rang==0)         write (6, '(A,D10.3)') 'volumeperat=', voluperat
     if(rang==0)         write (6, '(A,D10.3)') 'Rvois=', RVois
     if(rang==0)         write (6, *) 'NVperat= ', nvperat
     if (ldemitab) then
        nvois=max(Int(1.5*nvperat*im),100)
        nvat=max(Int(nvperat*1.3),10)
     else
        nvois=max(Int(1.5*nvperat*im),100)
        nvat=max(Int(nvperat*1.3),10)
     end if

     if(rang==0)         write (6, *) 'Nvois= ', nvois
     allocate(indi(nvois))
  else

  end if


  qtot = 0
  qtot = sum(q(:ntyp)*na(:ntyp))
  if ((qtot/=0.0).and.(rang==0)) write (6, *) ' CHARGE NON NULLE !! = ', qtot

  izonr = int(zlmin/r3cm)

  if(rang==0) write(6,*)
  if(rang==0) write(6,*)' TABLEAUX DIMENSIONES POUR UNE BOITE UNIFORME !! ' 
  if(rang==0) write(6,*) '-------------------------------------------------------------------'
  if(rang==0) write(6,*)

  return
end subroutine divid
