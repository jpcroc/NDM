*-*-*-*-*-*-*-*-*-*-* ORGANIGRAMME *-*-*-*-*-*-*-*-*-*-
PAS A JOUR!!!!!!
<> signifie ebventuellement
main ->
	-> readdm
	->prog
		->init 				!initialisations diverses
			/-> input		!lecture de .potin
			/-> inputeam		!lecture de .potin
			-> config		!construction de la boite a partir de .cin ou .gin
			<> -> rasmol		! ecriture d'un fichier rasmol
			<> -> angle             ! ecriture d'un fichier donn_angle pour post-traitement des angles
			->divid 		!determination des tailels de cel. et param Ewald
			-> DynamicalAllocationCell !allocationns dynamiques
			->calpo			!tabulation des potentiels
				->zieg2		!tabulation de Ziegler
			->calpoeam			!tabulation des potentiels
				->zieg2		!tabulation de Ziegler
			->neigcel		!tabulations des voisinages de grandes  celulles
			->neigcelsm		!tabulations des voisinages de petites celulles
			<> ->layer		!gestion de la fracture
			->caltabt		!repartition des atomes entre les grandes celulles
			->caltabtsm		!repartition des atomes entre les petites celulles
			<> -> caltabi		!construction de la table des voisins
			-> initspeed 		!initialisations des vitesses
			<> -> initcasca		!initialisation de l'eventuelle cascade
			<> -> deftimestep 	!determination du pas en temps optimal
		<> ->dmloop
			boucle
			->calfo	! routeur pour le calcul des forces		
				!calcul des forces des termes de paire
				<> -> calfoeamctabvois      ! table des voisins
				<> -> calfoeamccel          ! methode des celulles
				<> -> calfo2ctabvois      ! table des voisins
				<> -> calfo2ccel          ! methode des celulles
				<> -> calfoew		!terme d'Ewald
					<>-> epme       !particle Mesh Ewald
				<> -> calfo3c		!forces a trois corps
				<> -> calfobox		
				!forces sur la boite et les atomes en P constante
			->dyn ou trempe ou CG	!deplacement des atomes
			<>-> scalebox		! deformation de la boite en pression constante
			-> analyse		!analyse de l'etat du systame
				-> calctemp	!calcul de la temperature et la pression
				-> calccoordo	!calcul de la coordinence de chaque atome
				-> calcdepla	!calcul du deplacement de chaque atome pour 1er seuil
                                -> calcdepla2   !calcul du deplacement de chaque atome pour 2nd seuil>1er seuil
				-> calcrdf	!calcul de la RDF
			-> controle		!controle (cad modification du systeme)
				->caltabt	!repartition des atomes entre grandes cellules
				->caltabtsm	!repartition des atomes entre petites cellules
				<> -> caltabi	!construction de la table des voisins
				<> -> deform	! deformation par la fissure
				controle du pas en temps, temperature(tmax,tcou,tcooling),
	        	        "arret avant la fin", correction de la derive
			->sauvegardes		!ecriture du fichier .cout(structure==.cin)
                        <>->sauvegarde.f        ! stocke positions+temperature+pression+vitesse dans fichier binaire .cout
                        <>->sauveposition.f     ! stocke toutes les positions atomiques en binaire dans fichier .coutposition
			fin de la boucle
		<> ->dmloop_vverlet
			<>->nhcint(vp,ityp) 	! initialisation pour Nose
			<>->init_nhcp 		! initialisation pour Nose-Parrinnello-Rahman
			boucle
			<>-> nhcint(vp,ityp) 
			<>->calpext(symten,hpext) ! Calculate Pext = P + at*symten*h^t/V
			<>->nhcpint(vp,ityp)
			->dyn_vverlet ou trempe ou CG	!deplacement des atomes
				1/2update velocities
				update positions
				->period
				<> -> scalebox
				->caltabt(sm)
				->calfo
				1/2update velocities
			-> analyse		!analyse de l'etat du systame
			-> controle		!controle (cad modification du systeme)
			->sauvegardes		!ecriture du fichier .cout(structure==.cin)


		->endrun
                <> -> rasmol    ! ecriture fichier rasmol
                <> -> angle     ! ecriture fichier donn_angle 

